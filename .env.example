# Configuration du module de scraping NIRD

# Chunking configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_TOKENS=8000

# Output configuration
OUTPUT_DIR=data
OUTPUT_FILE=scraped_data.json

# API configuration
API_TITLE=NIRD Chatbot API
API_VERSION=1.0.0
API_DESCRIPTION=API pour le chatbot NIRD - Nuit de l'Info 2025

# Module 2: Semantic search configuration
HISTORY_FILE=data/historique_recherches.json
MIN_SIMILARITY_SCORE=0.12
SEARCH_TOP_K=1

# Module 3: Chatbot configuration (Groq API - GRATUIT!)
# Obtenez votre clé gratuite sur: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_TEMPERATURE=1.5
CHATBOT_MAX_TOKENS=200
