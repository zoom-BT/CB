# Configuration Git pour la compatibilité Windows/Linux

# Fins de ligne automatiques pour les fichiers texte
* text=auto

# Fichiers Python
*.py text eol=lf

# Scripts shell (toujours LF)
*.sh text eol=lf

# Scripts batch Windows (toujours CRLF)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Configuration
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
.env* text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# JSON, YAML
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
